# Copy this file to .env and fill in your own values
PORT=5000

# If the password has "@" write it as %40 (e.g. pass@123 -> pass%40123)
# Default PostgreSQL port is 5432 (this project's first PC uses 5433)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/realestate"

# secret key used to sign login tokens (keep private, long random text)
# generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"

# the Next.js frontend address (allowed by CORS)
FRONTEND_URL="http://localhost:3000"
