// Prisma schema: every table of our project is defined here.
// After changing this file run: npx prisma migrate dev --name <what_changed>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER = normal user (can post and enquire), ADMIN = manages master data
enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(15)
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users") // table name in PostgreSQL
}

// ---------- MASTERS (created by admin, chosen by users) ----------

model City {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120) // "Chennai" -> "chennai", used in URLs
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cities")
}
